  "description": "MCP server for Google Tasks with OAuth2 (MCP Authorization spec, Google as upstream IdP)",
  "type": "module",
  "license": "MIT",
  "author": "Markus Rother <markus@rotheric.com>",
  "main": "dist/index.js",
  "bin": {
    "g-tasks-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "dotenv": "^16.4.5",
