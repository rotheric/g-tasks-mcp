# Existing Google Web application OAuth client. Enable Google Tasks API.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Defaults: local loopback service. Hosted operation requires HTTPS BASE_URL.
# PORT=3789
# HOST=127.0.0.1
# BASE_URL=http://localhost:3789
# DEPLOYMENT_MODE=local
# DATA_DIR=~/.g-tasks-mcp

# Trusted owner is normally enrolled with `node dist/index.js setup`.
# Supply only an independently verified Google subject; never an email address.
# OWNER_GOOGLE_SUB=
# SETUP_URL=http://localhost:3789/oauth/google/callback

# Hosted: explicit trusted reverse-proxy IPs/subnets, comma-separated.
# TRUST_PROXY=127.0.0.1
# Explicit origins for browser-based MCP clients, comma-separated.
# BROWSER_ORIGINS=https://your-harness.example

# Semantic + lexical task search (enabled by default). Reuses an existing Qdrant; no Docker required.
# Host runtime (macOS): localhost. VM runtime: host.lima.internal if services are on host.
# Set false to explicitly disable search.
# SEARCH_ENABLED=false
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION_PREFIX=g_tasks
# Local Ollama; install the model first: ollama pull embeddinggemma
# EMBEDDING_URL=http://localhost:11434
# EMBEDDING_MODEL=embeddinggemma
# EmbeddingGemma retrieval prefixes are automatic. Other models default to raw text.
# Override when your model requires query/document instructions (trailing spaces matter).
# EMBEDDING_QUERY_PREFIX="task: search result | query: "
# EMBEDDING_DOCUMENT_PREFIX="title: none | text: "
